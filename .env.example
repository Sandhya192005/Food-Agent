# Copy this file to .env and fill in real values. Never commit .env.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1-mini

# --- Database ---
# SQLite (default, zero setup): sqlite:///./data/food_agent.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/food_agent_db
DATABASE_URL=sqlite:///./data/food_agent.db

# --- Storage (meal photos) ---
# local = save photos in MEDIA_ROOT; s3 = save them in an AWS S3 bucket.
# Old photos stay readable after switching: each meal remembers where its photo is.
STORAGE_BACKEND=local
MEDIA_ROOT=./media

# --- AWS S3 (only when STORAGE_BACKEND=s3) ---
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# Keys of an IAM user that can only access this bucket. Leave empty to use ~/.aws/credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# How long a photo link stays valid (seconds).
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# --- Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Water tracking ---
WATER_REMINDER_THRESHOLD_MINUTES=90
WATER_SNOOZE_MINUTES=60

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
DUPLICATE_UPLOAD_WINDOW_MINUTES=15

# --- Meal analysis bounds ---
MAX_ITEM_CALORIES=1200
MAX_MEAL_CALORIES=4000
LOW_CONFIDENCE_THRESHOLD=0.5

# --- Misc ---
ENVIRONMENT=dev
CORS_ORIGINS=
LOG_LEVEL=INFO
